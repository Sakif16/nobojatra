# NoboJatra environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# Each note says what happens when the variable is unset.

# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string. Unset: the app will not start.
MONGODB_URI=your_mongodb_connection_string

# Random string that signs sessions, for example from `openssl rand -base64 32`.
# Unset: sign-in does not work.
BETTER_AUTH_SECRET=your_auth_secret

# The app's own URL. Unset: auth links (such as password reset) can point at the wrong place.
BETTER_AUTH_URL=http://localhost:3000

# OpenRouteService key. Unset: route search fails.
ORS_API_KEY=your_openrouteservice_api_key

# ─── Recommended ─────────────────────────────────────────────────────────────

# OpenWeatherMap key. Unset: no weather conditions and no weather-based fare rules.
OPENWEATHER_API_KEY=your_openweather_api_key

# ─── Optional ────────────────────────────────────────────────────────────────

# Database for app and auth data. Unset: defaults to nobojatra.
# Changing it on an existing database hides every existing account.
MONGODB_DB=nobojatra

# TomTom key. Unset: live traffic and the traffic overlay are unavailable.
# TomTom has no traffic data for Bangladesh.
TOMTOM_API_KEY=your_tomtom_api_key

# Resend key and sender for password reset emails. Unset: reset emails are not sent.
# The sender must be on a domain verified in Resend. Otherwise emails reach only
# the Resend account owner.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=NoboJatra <your_verified_sender@yourdomain.com>

# Live fare quote service. Unset: fares come from the built-in rate card.
PATHAO_FARE_API=https://pathao-fare-api.onrender.com

# Shared secret for the scheduled alert check (/api/alerts/evaluate).
# Unset: the scheduled check is always refused, and alerts are evaluated only
# while a signed-in user has the app open.
ALERT_EVALUATION_SECRET=your_random_secret

# Identifies the app to the place-search service, as the OpenStreetMap usage
# policy requires. Unset: uses "NoboJatra/1.0 (+https://github.com/Sakif16/nobojatra)".
# Set it only to add a private contact email, for example in production.
# NOMINATIM_USER_AGENT=NoboJatra/1.0 (+https://github.com/Sakif16/nobojatra; team@example.com)

# Place-search server. Unset: uses the public OpenStreetMap server.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OpenWeatherMap API base URL. Unset: uses the standard OpenWeatherMap URL.
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Teachable Machine image model for photo search. Unset: photo search fails on first use.
NEXT_PUBLIC_TM_MODEL_URL=your_teachable_machine_model_url

# Mapbox is not used. Leave this unset: setting it switches the map to Mapbox
# layers that are not configured correctly.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# NoboJatra environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# Each note says what happens when the variable is unset.
#
# The app checks these when it starts. A missing required variable stops it
# with one message naming every one that is missing; a missing optional one is
# logged with the feature it switches off. A value still reading `your_…`
# counts as unset.

# ─── Required: the app will not start without all four ───────────────────────

# MongoDB connection string.
MONGODB_URI=your_mongodb_connection_string

# At least 32 characters to sign sessions. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=your_auth_secret

# The app's own URL. Sign-in and password reset links are built from it.
BETTER_AUTH_URL=http://localhost:3000

# OpenRouteService key. Every plan starts from a route, so nothing works without it.
ORS_API_KEY=your_openrouteservice_api_key

# ─── Optional features: uncomment to switch each one on ──────────────────────

# OpenWeatherMap key. Unset: no weather on fares or rankings, no weather-based
# fare adjustment, and no vehicle held back for weather. The screens say
# weather is not set up.
# OPENWEATHER_API_KEY=your_openweather_api_key

# TomTom key. Unset: no live traffic and no traffic overlay on the map; times
# and fares use no traffic data. The screens say traffic is not set up.
# TomTom has no traffic data for Bangladesh, so this changes nothing there.
# TOMTOM_API_KEY=your_tomtom_api_key

# Live fare quote service. Unset: fares come from the seeded rate card and are
# labelled as rate-card estimates.
# PATHAO_FARE_API=https://pathao-fare-api.onrender.com

# Resend key for password reset emails. Unset: the reset page says reset is
# not set up instead of showing the form.
# RESEND_API_KEY=your_resend_api_key

# Sender for those emails. Must be on a domain verified in Resend. Unset:
# Resend's testing sender is used, which delivers only to the Resend account
# owner's own address.
# RESEND_FROM_EMAIL=NoboJatra <sender@your-verified-domain.com>

# Teachable Machine image model for photo search. Unset: photo search is disabled
# and the planner explains why. Read at build time, so rebuild after changing it.
# NEXT_PUBLIC_TM_MODEL_URL=https://teachablemachine.withgoogle.com/models/XXXXXXXX/

# ─── Optional settings: the defaults suit most setups ────────────────────────

# Database for app and auth data. Unset: defaults to nobojatra.
# Changing it on an existing database hides every existing account.
# MONGODB_DB=nobojatra

# Identifies the app to the place-search service, as the OpenStreetMap usage
# policy requires. Unset: uses "NoboJatra/1.0 (+https://github.com/Sakif16/nobojatra)".
# Set it only to add a private contact email, for example in production.
# NOMINATIM_USER_AGENT=NoboJatra/1.0 (+https://github.com/Sakif16/nobojatra; team@example.com)

# Place-search server. Unset: uses the public OpenStreetMap server.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OpenWeatherMap API base URL. Unset: uses the standard OpenWeatherMap URL.
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Daily cap on calls to one provider, counted in the database. Unset: the
# defaults in lib/provider-budget.ts. Providers: NOMINATIM, OPENROUTESERVICE,
# TOMTOM_ROUTING, TOMTOM_TILES, OPENWEATHER, PATHAO.
# DEMO_BUDGET_NOMINATIM=2000

# Mapbox is not used. Leave this unset: setting it switches the map to Mapbox
# layers that are not configured correctly.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Auth proxy header: leave unset until the actual host is verified to overwrite
# it and the origin is accessible only through that proxy. Unset: auth limits
# use shared per-path buckets plus email/user-based limits; forged forwarding
# headers are ignored. Supported: x-forwarded-for, x-real-ip, cf-connecting-ip.
# An appending multi-value header falls back to the shared bucket.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
